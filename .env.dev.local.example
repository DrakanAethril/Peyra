# Template for .env.dev.local (gitignored). One step before the first `docker compose up`:
#
#   cp .env.dev.local.example .env.dev.local
#
# Every value here is a throwaway for the local, fictitious stack (MariaDB, OpenLDAP, the Mercure
# hub): nothing real is reached from development. Change them if you like; keep the pairs in step
# (MARIADB_* with DATABASE_URL, LDAP_SEARCH_PASSWORD with frankenphp/ldap/10-tree.ldif).

###> doctrine/doctrine-bundle ###
MARIADB_ROOT_PASSWORD=peyra-dev-root
MARIADB_USER=peyra
MARIADB_PASSWORD=peyra-dev-db
MARIADB_DATABASE=peyra
DATABASE_URL="mysql://peyra:peyra-dev-db@database:3306/peyra?serverVersion=11.8.6-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> mercure ###
MERCURE_PUBLISHER_JWT_KEY=peyra-dev-mercure-publisher-key-0123456789abcdef
MERCURE_SUBSCRIBER_JWT_KEY=peyra-dev-mercure-subscriber-key-0123456789abcdef
MERCURE_JWT_SECRET=peyra-dev-mercure-publisher-key-0123456789abcdef
###< mercure ###

###> ldap ###
LDAP_ADMIN_PASSWORD=peyra-dev-admin
LDAP_HOST=openldap
LDAP_PORT=1389
LDAP_ENCRYPTION=none
LDAP_BASE_DN="dc=peyra,dc=lan"
LDAP_SEARCH_DN="cn=svc-peyra,ou=service,dc=peyra,dc=lan"
LDAP_SEARCH_PASSWORD=peyra-dev-svc
PEYRA_LDAP_STABLE_ID=entryUUID
###< ldap ###

###> peyra/access ###
# The demonstration administrator (CLAUDE.md, « Demonstration accounts »).
PEYRA_ADMIN_LOGINS=prof.martin
###< peyra/access ###
