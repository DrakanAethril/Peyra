# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> docker compose ###
# Read by Docker Compose for substitution as well as by Symfony. Formatool runs on the same
# machine on ports 80 and 443 with the image app-php-dev: Peyra keeps out of its way.
COMPOSE_PROJECT_NAME=peyra
HTTP_PORT=8180
HTTPS_PORT=8143
HTTP3_PORT=8143
###< docker compose ###

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Placeholder only: the real value is credential-shaped and comes from .env.dev.local (dev) or
# .env.prod.local (production). The production image's build compiles the container with this.
# MariaDB in development as in production: migrations are portable SQL.
DATABASE_URL="mysql://peyra:!ChangeMe!@database:3306/peyra?serverVersion=11.8.6-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/lock ###
# Overridden in the containers (compose files) by a directory both `php` and `worker` mount.
LOCK_DSN=flock
###< symfony/lock ###


###> peyra/directory ###
# The establishment's directory (CLAUDE.md, « Authentication and access »). Placeholders only: the
# values come from .env.dev.local (dev, the fictitious OpenLDAP) or .env.prod.local (production).
LDAP_HOST=localhost
LDAP_PORT=389
LDAP_ENCRYPTION=none
LDAP_BASE_DN=
LDAP_SEARCH_DN=
LDAP_SEARCH_PASSWORD=
# The CA of the directory's certificate (LDAPS in production); empty for plain LDAP.
LDAP_TLS_CA_CERT_PATH=
# The login attribute searched as (uid=…), and the class of the groups whose `member` names a person.
LDAP_USERNAME_ATTRIBUTE=uid
LDAP_GROUP_OBJECT_CLASS=groupOfNames
# The attribute that keeps a person's account across a renamed login: objectGUID in production
# (Samba AD), entryUUID on the development OpenLDAP. uidNumber is read when it is absent.
PEYRA_LDAP_STABLE_ID=objectGUID
###< peyra/directory ###

###> peyra/access ###
# The entry rule (README of the plan, § 9): a student enters as a member of one of these groups, a
# teacher as a member of one of these, as a login of PEYRA_ADMIN_LOGINS or as a teacher authorised
# by name inside the application. Comma-separated.
PEYRA_STUDENT_GROUPS=cg-1,cg-2
PEYRA_TEACHER_GROUPS=cg-1,cg-2
# The first administrators: the flag is set at each sign-in of these logins (teachers only).
PEYRA_ADMIN_LOGINS=
# Where the sign-in page sends a forgotten password (the establishment's procedure); empty, it says
# to ask the establishment.
PEYRA_PASSWORD_HELP_URL=
# Shown on « À propos »; the production build sets it.
PEYRA_VERSION=dev
###< peyra/access ###
