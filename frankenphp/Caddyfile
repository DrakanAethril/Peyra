{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
		# Redact the authorization query parameter that can be set by Mercure
		format filter {
			request>uri query {
				replace authorization REDACTED
			}
		}
	}

	root /app/public
	encode zstd br gzip

	mercure {
		# One hub, named, shared by the two sites SERVER_NAME declares (the public one and php:80,
		# the address the application publishes to): the hub refuses two unnamed instances.
		name peyra
		# The Mercure 1.0 hub bundled since FrankenPHP 1.13 accepts the 0.x protocol that
		# symfony/mercure speaks (the `mercure` JWT claim, `?topic=` subscriptions, the
		# mercureAuthorization cookie) only in compatibility mode, and refuses to start on
		# publisher_jwt/subscriber_jwt without it.
		protocol_version_compatibility 8
		# Publisher JWT key
		publisher_jwt {env.MERCURE_PUBLISHER_JWT_KEY} {env.MERCURE_PUBLISHER_JWT_ALG}
		# Subscriber JWT key
		subscriber_jwt {env.MERCURE_SUBSCRIBER_JWT_KEY} {env.MERCURE_SUBSCRIBER_JWT_ALG}
		# Extra directives
		{$MERCURE_EXTRA_DIRECTIVES}
	}

	vulcain

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	# Disable Topics tracking if not enabled explicitly: https://github.com/jkarlin/topics
	header ?Permissions-Policy "browsing-topics=()"

	# AssetMapper content-hashes what it compiles into public/assets, so those bytes never change
	# under a given URL. `?` keeps the dev server's own decision (no public/assets there).
	@immutableAssets path /assets/*
	header @immutableAssets ?Cache-Control "public, max-age=31536000, immutable"

	@phpRoute {
		not path /.well-known/mercure*
		not file {path}
	}
	rewrite @phpRoute index.php

	@frontController path index.php
	php @frontController {
		{$FRANKENPHP_SITE_CONFIG}

		worker {
			file ./public/index.php
			{$FRANKENPHP_WORKER_CONFIG}
		}
	}

	file_server {
		hide *.php
	}
}
