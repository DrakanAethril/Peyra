{#
 # Px:ContextBar - the ribbon under the top bar when a teacher works in a dossier (design-ui.md C4,
 # design-ux.md § 2.4): violet in a student's or a group's dossier, gold (`tone="template"`) in a
 # template. Who is acting, and the way back.
 #}
{% props backLabel, backHref, tone = 'role' %}
<div{{ attributes.defaults({class: 'px-contextbar' ~ (tone == 'template' ? ' px-contextbar--template' : '')}) }} role="note">
    <span>{% block content %}{% endblock %}</span>
    <a href="{{ backHref }}">{{ backLabel }}</a>
</div>
