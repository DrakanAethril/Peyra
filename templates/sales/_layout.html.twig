{#
 # Ventes (design-ux.md §§ 2.5 and 3.2; lot 2): the module's tab bar - Clients, Devis · Commandes ·
 # Livraisons, Factures · Avoirs · Acomptes (step 2.3), Règlements (step 2.6b); Suivi joins it with step 2.7.
 # A screen sets `sales_tab` (customers, orders, invoices, payments) and `dossier_title` outside any block.
 # Closed to a profile that does not read the sales (SALES_READ).
 #}
{% extends 'dossier/_layout.html.twig' %}

{% set rail_current = 'sales' %}

{% block module_tabs %}
    <twig:Px:ModuleTabs label="Ventes" :tabs="[
        {label: 'Clients', href: path('app_sales_customers', {dossier: dossier.id}), current: (sales_tab ?? '') == 'customers'},
        {label: 'Devis · Commandes · Livraisons', href: path('app_sales_documents', {dossier: dossier.id, side: 'sales', type: 'quote'}), current: (sales_tab ?? '') == 'orders'},
        {label: 'Factures · Avoirs · Acomptes', href: path('app_sales_documents', {dossier: dossier.id, side: 'sales', type: 'invoice'}), current: (sales_tab ?? '') == 'invoices'},
        {label: 'Règlements', href: path('app_payments', {dossier: dossier.id, direction: 'receipts'}), current: (sales_tab ?? '') == 'payments'},
    ]"/>
{% endblock %}
