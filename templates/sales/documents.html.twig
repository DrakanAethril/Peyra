{#
 # Ventes › Devis · Commandes · Livraisons and Factures et avoirs (step 2.3, gabarit L): the
 # documents of one type, the chips of its tab's family. Drafts first; then by number, newest first.
 #}
{% extends 'sales/_layout.html.twig' %}

{% set sales_tab = doc_type.invoicing ? 'invoices' : 'orders' %}
{% set dossier_title = doc_type.plural %}
{% set can_enter = is_granted('SALES_ENTER', dossier) %}
{% set can_create = can_enter and doc_type.value != 'credit_note' %}
{% set status_keys = can_create ? [{combo: 'N', verb: 'Nouveau'}] : [] %}

{% block page_head %}
    <twig:Px:PageHead title="{{ doc_type.plural }}" :trail="[
        {label: 'Ventes', href: path('app_sales_documents', {dossier: dossier.id, type: 'quote'})},
        {label: doc_type.plural, href: path('app_sales_documents', {dossier: dossier.id, type: doc_type.value})},
    ]">
        <twig:block name="actions">
            {% if can_create %}<twig:Px:Button href="{{ path('app_sales_document_new', {dossier: dossier.id, type: doc_type.value}) }}" variant="primary" icon="plus" shortcut="N">Nouveau : {{ doc_type.label|lower }}</twig:Px:Button>{% endif %}
        </twig:block>
    </twig:Px:PageHead>
{% endblock %}

{% block page %}
    <twig:Px:Card :flush="true">
        <twig:Px:Filters action="{{ path('app_sales_documents', {dossier: dossier.id, type: doc_type.value}) }}">
            {% for case in family %}
                <twig:Px:FilterChip label="{{ case.plural }}" href="{{ path('app_sales_documents', {dossier: dossier.id, type: case.value}) }}" :count="counts[case.value]" :current="case == doc_type"/>
            {% endfor %}
        </twig:Px:Filters>
        {% if document_rows is empty %}
            <twig:Px:Empty icon="file-text" title="Aucun document" text="{{ doc_type.value == 'credit_note' ? 'Un avoir se crée depuis la facture validée qu’il corrige : « Créer un avoir » sur sa fiche.' : 'Aucun document de ce type pour l’instant. « Nouveau » en ouvre un brouillon ; un document validé se transforme en le suivant.' }}"/>
        {% else %}
            <twig:Px:Table caption="{{ doc_type.plural }} de {{ dossier.name }}" :rows="true">
                <thead>
                    <tr>
                        <th scope="col">Numéro</th>
                        <th scope="col" class="px-u-num">Date</th>
                        <th scope="col">Client</th>
                        <th scope="col">Référence</th>
                        <th scope="col">Origine</th>
                        <th scope="col" class="px-u-num">Total HT</th>
                        <th scope="col" class="px-u-num">Total TTC</th>
                        <th scope="col">État</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in document_rows %}
                        {% set totals = row.totals %}
                        <tr data-rows-target="row">
                            <td class="px-u-code"><a class="px-link" href="{{ path('app_sales_document', {dossier: dossier.id, id: row.id}) }}">{{ row.number ?? 'Brouillon' }}</a></td>
                            <td class="px-u-num">{{ row.date|date_fr }}</td>
                            <td class="px-u-fill" title="{{ row.customer.name }}">{{ row.customer.name }}</td>
                            <td>{{ row.reference }}</td>
                            <td class="px-u-code">{{ row.source ? row.source.number : '' }}</td>
                            <td class="px-u-num">{{ totals.excludingTax|amount }}</td>
                            <td class="px-u-num">{{ totals.includingTax|amount }}</td>
                            <td><twig:Px:Badge :of="row.state"/>{% if row.sentOn %} <twig:Px:Badge tone="info" label="Envoyé"/>{% endif %}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </twig:Px:Table>
        {% endif %}
        <twig:Px:Pager :total="shown_total" :perPage="list_page.perPage" :page="list_page.page" :sizes="true"/>
    </twig:Px:Card>
{% endblock %}

{% block facts %}<span>{{ doc_type.plural }} · <b>{{ shown_total }}</b></span>{% endblock %}
