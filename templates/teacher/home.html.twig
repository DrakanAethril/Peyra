{% extends 'teacher/_layout.html.twig' %}

{% set rail_current = 'accueil' %}

{% block title %}Accueil · Espace enseignant · Peyra{% endblock %}

{% block page_head %}
    <twig:Px:PageHead title="Accueil"/>
{% endblock %}

{% block page %}
    <twig:Px:Card>
        <twig:Px:Empty :page="true" icon="graduation-cap" title="Rien à suivre pour l’instant" text="Vos classes, les missions en cours et les copies à corriger s’afficheront ici.">
            <twig:block name="action">
                {% if is_granted('ROLE_ADMIN') %}
                    <twig:Px:Button variant="primary" href="{{ path('app_admin_teachers') }}" icon="settings">Administration</twig:Px:Button>
                {% endif %}
            </twig:block>
        </twig:Px:Empty>
    </twig:Px:Card>
{% endblock %}

{% block status %}<span>{{ app.user.displayName }}{% if is_granted('ROLE_ADMIN') %} · <b>administrateur</b>{% endif %}</span>{% endblock %}
