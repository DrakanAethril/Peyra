{#
 # The teacher's home (design-ux.md § 3.3, gabarit T): indicators that are links (classes, students
 # of my classes, « À placer »), my classes, and for an administrator « Préparer l'année » while
 # something is missing. A year without classes: § 4.1, step 7.
 #}
{% extends 'teacher/_layout.html.twig' %}

{% set rail_current = 'accueil' %}

{% block title %}Accueil · Espace enseignant · Peyra{% endblock %}

{% block page_head %}
    <twig:Px:PageHead title="Accueil"/>
{% endblock %}

{% block page %}
    {% if rows is empty %}
        {{ include('classes/_no_year.html.twig') }}
    {% else %}
        <div class="px-kpis">
            <twig:Px:Kpi label="Mes classes" value="{{ mine|length }}" note="{{ year.label }}" href="{{ path('app_teacher_classes') }}"/>
            <twig:Px:Kpi label="Étudiants de mes classes" value="{{ mine|reduce((sum, r) => sum + r.students, 0) }}" href="{{ path('app_teacher_classes') }}"/>
            <twig:Px:Kpi label="À placer" value="{{ unplaced }}" note="{{ unplaced > 0 ? 'sans classe cette année' : 'tout le monde a sa classe' }}" :state="unplaced > 0 ? 'alert' : 'ok'" href="{{ path('app_teacher_unplaced') }}"/>
            <twig:Px:Kpi label="Classes de l’année" value="{{ rows|length }}" note="{{ rows|reduce((sum, r) => sum + r.students, 0) }} étudiants" href="{{ path('app_teacher_classes') }}"/>
        </div>

        {% if unplaced > 0 %}
            <twig:Px:Alert tone="warning" actionLabel="Placer les étudiants" actionHref="{{ path('app_teacher_unplaced') }}">
                {{ unplaced }} {{ unplaced > 1 ? 'étudiants attendent' : 'étudiant attend' }} une classe en {{ year.label }}.
            </twig:Px:Alert>
        {% endif %}

        {% set missing = checks|filter(c => not c.passed) %}
        {% if missing is not empty %}
            <twig:Px:Card title="Préparer l’année" meta="visible des administrateurs">
                <twig:Px:Checks :items="checks|map(c => {state: c.passed ? 'passed' : 'warning', text: c.text})"/>
                <twig:block name="actions"><twig:Px:Button size="sm" href="{{ path('app_admin_years') }}" icon="settings">Administration</twig:Px:Button></twig:block>
            </twig:Px:Card>
        {% endif %}

        <twig:Px:Card :flush="true" title="Mes classes" meta="{{ year.label }}">
            {% if mine is empty %}
                <twig:Px:Empty icon="graduation-cap" title="Vous n’êtes rattaché à aucune classe" text="{{ is_granted('ROLE_ADMIN') ? 'Rattachez-vous à vos classes dans Administration › Classes.' : 'Un administrateur vous rattache à vos classes ; vous lisez en attendant toutes les classes de l’année.' }}">
                    <twig:block name="action"><twig:Px:Button href="{{ path('app_teacher_classes') }}" icon="graduation-cap">Classes de l’année</twig:Px:Button></twig:block>
                </twig:Px:Empty>
            {% else %}
                {{ include('classes/_class_table.html.twig', {class_rows: mine, caption: 'Mes classes en ' ~ year.label}) }}
            {% endif %}
        </twig:Px:Card>
    {% endif %}
{% endblock %}

{% block status %}<span>{{ app.user.displayName }}{% if is_granted('ROLE_ADMIN') %} · <b>administrateur</b>{% endif %}</span>{% if year %}<span>Année · <b>{{ year.label }}</b></span>{% endif %}{% endblock %}
