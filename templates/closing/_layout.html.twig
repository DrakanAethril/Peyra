{#
 # Immobilisations et clôture (design-ux.md §§ 2.5 and A2): the module's tab bar. Lot 1 brings its
 # « Clôture » tab and its FEC view (step 1.9a); the fixed assets, the inventory, the statements and
 # the closing of periods and exercises join it at lot 3. A screen sets `dossier_title` outside any
 # block.
 #}
{% extends 'dossier/_layout.html.twig' %}

{% set rail_current = 'closing' %}

{% block module_tabs %}
    <twig:Px:ModuleTabs label="Immobilisations et clôture" :tabs="[
        {label: 'Clôture', href: path('app_closing_fec', {dossier: dossier.id}), current: true},
    ]"/>
{% endblock %}
