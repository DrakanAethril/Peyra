{#
 # Pièces › Générateur (design-ux.md § 3.3, gabarit A; lot 2, step 2.1b): the template to complete,
 # then the invoice described on the left - supplier, number, dates, lines, the faults it should
 # carry - and its PDF on the right. The form is a GET: « Aperçu » (Ctrl Entrée) is its address;
 # « Générer » (F10) posts it, its token as the button's value, and deposits the pièce into the
 # template's inbox. `dossier` is null until a template is chosen.
 #}
{% extends 'teacher/_layout.html.twig' %}

{% set rail_current = 'pieces' %}
{% set status_keys = dossier ? [{combo: 'Ctrl+Enter', verb: 'Aperçu'}, {combo: 'F10', verb: 'Générer'}] : [] %}

{% block title %}Générateur de pièces · Peyra{% endblock %}

{% block module_tabs %}
    <twig:Px:ModuleTabs label="Pièces" :tabs="[{label: 'Factures', href: path('app_generator'), current: true}, {label: 'Relevés', href: path('app_statement_generator'), current: false}]"/>
{% endblock %}

{% block page_head %}
    <twig:Px:PageHead title="Générateur de pièces" :trail="[
        {label: 'Pièces', href: path('app_generator')},
        {label: 'Générateur', href: dossier ? path('app_generator_dossier', {dossier: dossier.id}) : path('app_generator')},
    ]">
        <twig:block name="actions">
            {% if dossier %}
                <twig:Px:Button type="submit" form="generator" shortcut="Ctrl+Enter" icon="eye">Aperçu</twig:Px:Button>
                <twig:Px:Button type="submit" variant="primary" form="generator" shortcut="F10 Ctrl+S" icon="files" formmethod="post" formaction="{{ path('app_generator_dossier', {dossier: dossier.id}) }}" name="_token" value="{{ csrf_token('generator-' ~ dossier.id) }}">Générer</twig:Px:Button>
            {% endif %}
        </twig:block>
    </twig:Px:PageHead>
{% endblock %}

{% block page %}
    {% if template_options is empty %}
        <twig:Px:Empty title="Aucun dossier modèle à compléter" text="Le générateur dépose ses pièces dans un dossier modèle que vous pouvez modifier : créez-en un dans la bibliothèque." icon="book-copy" :page="true"/>
    {% else %}
        <form method="get" action="{{ path('app_generator') }}" class="px-cluster">
            <twig:Px:Field id="template" label="Dossier modèle">
                <twig:Px:Select id="template" name="dossier" placeholder="Choisir un dossier modèle…" :options="template_options" value="{{ dossier ? dossier.id : '' }}" :autofocus="dossier is null"/>
            </twig:Px:Field>
            <twig:Px:Button type="submit" icon="arrow-right">Ouvrir</twig:Px:Button>
        </form>

        {% if dossier %}
            {% if order.errors is not empty %}
                <twig:Px:Alert tone="danger">La facture n’est pas générée : {{ order.errors|length > 1 ? order.errors|length ~ ' champs sont à corriger' : 'un champ est à corriger' }}.</twig:Px:Alert>
            {% endif %}
            {{ include('document/_generator_form.html.twig') }}
        {% endif %}
    {% endif %}
{% endblock %}

{% block status %}
    {%- for message in app.flashes('status') %}<span>{{ message }}</span>{% else %}{% if dossier %}<span>Dossier modèle · <b>{{ dossier.libraryTitle }}</b></span><span>Date du dossier · <b>{{ dossier.dossierDate|date_fr }}</b></span>{% endif %}{% endfor -%}
{% endblock %}
