{# Comptabilité › Éditions › Grand livre as a PDF (lot 1, step 1.5b; design-ui.md § 3.6, A4 landscape): the screen's state without its links. #}
{% extends 'doc/_report.html.twig' %}

{% block content %}
    {% if report.isEmpty %}
        <p>Aucun compte n’a de mouvement du {{ window.exerciseStart|date_fr }} au {{ window.to|date_fr }}.</p>
    {% else %}
        <table class="px-doc__table">
            <colgroup><col style="width: 22mm"><col style="width: 15mm"><col style="width: 28mm"><col style="width: 31mm"><col style="width: 20mm"><col><col style="width: 27mm"><col style="width: 27mm"><col style="width: 30mm"></colgroup>
            <thead>
                <tr><th scope="col">Date</th><th scope="col">Journal</th><th scope="col">Pièce</th><th scope="col">Numéro</th><th scope="col">Tiers</th><th scope="col">Libellé</th><th scope="col" class="px-doc__num">Débit</th><th scope="col" class="px-doc__num">Crédit</th><th scope="col" class="px-doc__num">Solde</th></tr>
            </thead>
            {% for item in report.accounts %}
                <tbody>
                    <tr class="px-doc__group"><th colspan="9" scope="rowgroup"><span class="px-doc__code">{{ item.account.number }}</span> · {{ item.account.label }}</th></tr>
                    {% if report.hasOpening %}
                        <tr class="px-doc__dim"><td colspan="6">Solde au {{ window.eve|date_fr }}</td><td class="px-doc__num">{{ item.before.debit|amount_cell }}</td><td class="px-doc__num">{{ item.before.credit|amount_cell }}</td><td class="px-doc__num">{{ item.before.balance|balance }}</td></tr>
                    {% endif %}
                    {% for movement in item.movements %}
                        {% set line = movement.line %}
                        {% set entry = line.entry %}
                        <tr>
                            <td class="px-doc__code">{{ entry.entryDate|date('d/m/Y') }}</td>
                            <td class="px-doc__code">{{ entry.journal.code }}</td>
                            <td class="px-doc__code px-doc__cell-cut">{{ entry.document }}</td>
                            <td class="px-doc__code">{{ entry.numberLabel ?? 'Brouillard' }}</td>
                            <td class="px-doc__code">{{ line.thirdParty ? (line.thirdParty.auxiliaryCode ?? line.thirdParty.code) : '' }}</td>
                            <td class="px-doc__cell-cut">{{ line.label ?: entry.label }}</td>
                            <td class="px-doc__num">{{ line.debit|amount_cell }}</td>
                            <td class="px-doc__num">{{ line.credit|amount_cell }}</td>
                            <td class="px-doc__num">{{ movement.balanceAfter|balance }}</td>
                        </tr>
                    {% endfor %}
                    <tr class="px-doc__subtotal"><th scope="row" colspan="6">Total {{ item.account.number }}</th><td class="px-doc__num">{{ item.total.debit|amount }}</td><td class="px-doc__num">{{ item.total.credit|amount }}</td><td class="px-doc__num">{{ item.total.balance|balance }}</td></tr>
                </tbody>
            {% endfor %}
            <tfoot>
                <tr><td colspan="6">Total général · {{ report.accounts|length }} compte{{ report.accounts|length > 1 ? 's' : '' }}</td><td class="px-doc__num">{{ report.total.debit|amount }}</td><td class="px-doc__num">{{ report.total.credit|amount }}</td><td class="px-doc__num">{{ report.total.balance|balance }}</td></tr>
            </tfoot>
        </table>
    {% endif %}
{% endblock %}
