{#
 # Comptabilité (design-ux.md § 2.5): the module's tab bar - Saisie, Paramètres comptables; the
 # brouillard, the consultation and the editions join it with their steps. A screen sets
 # `module_current` (entry, settings; settings by default), `settings_current` for the three views of
 # the settings (plan de comptes, journaux, tiers) and `dossier_title`, outside any block.
 #}
{% extends 'dossier/_layout.html.twig' %}

{% set rail_current = 'accounting' %}

{% block module_tabs %}
    <twig:Px:ModuleTabs label="Comptabilité" :tabs="[
        {label: 'Saisie', href: path('app_accounting_entry', {dossier: dossier.id}), current: (module_current ?? 'settings') == 'entry'},
        {label: 'Paramètres comptables', href: path('app_accounting_accounts', {dossier: dossier.id}), current: (module_current ?? 'settings') == 'settings'},
    ]"/>
{% endblock %}
