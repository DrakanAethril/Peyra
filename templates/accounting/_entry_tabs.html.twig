{# The views of Comptabilité › Saisie (design-ux.md § 2.5): par journal, guidée - drawn only when the guided entry is open (Assistance::opensGuidedEntry()) -, à-nouveaux. #}
<twig:Px:Tabs label="Saisie" :tabs="[
    {label: 'Par journal', href: path('app_accounting_entry', {dossier: dossier.id}), current: entry_view == 'journal'},
]|merge((guided_open ?? false) ? [{label: 'Guidée', href: path('app_accounting_guided', {dossier: dossier.id}), current: entry_view == 'guided'}] : [])|merge([
    {label: 'À-nouveaux', href: path('app_accounting_opening', {dossier: dossier.id}), current: entry_view == 'opening'},
])"/>
