{#
 # Every error page in production (design-ux.md § 6.1): what happened and what to do, in the public
 # shell. A refusal is a 404, never a 403, so a page one may not see reads like one that is not there.
 #}
{% extends 'layout/public.html.twig' %}

{% block title %}{{ status_code == 404 ? 'Page introuvable' : 'Erreur' }} · Peyra{% endblock %}

{% block card %}
    <div class="px-public__body">
        {% if status_code == 404 %}
            <h1 class="px-public__title">Page introuvable</h1>
            <p class="px-u-center">Cette page n’existe pas, ou vous n’y avez pas accès.</p>
        {% else %}
            <h1 class="px-public__title">L’opération n’a pas abouti</h1>
            <p class="px-u-center">Le serveur n’a pas pu répondre. Vos saisies enregistrées sont conservées ; réessayez dans un instant.</p>
        {% endif %}
        <twig:Px:Button variant="primary" size="lg" href="/" :block="true">Revenir à l’accueil</twig:Px:Button>
    </div>
{% endblock %}
