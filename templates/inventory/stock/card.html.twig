{#
 # Achats et stocks › Stocks › the fiche de stock of an article (step 2.5, gabarit R): to a day (the
 # dossier's by default), each movement with what came in and went out - quantity, unit cost,
 # value at the article's method - and the stock after it; what each storage place holds.
 #}
{% extends 'inventory/_layout.html.twig' %}

{% set inventory_tab = 'stock' %}
{% set dossier_title = 'Fiche de stock ' ~ article.code %}
{% set can_enter = is_granted('PURCHASES_ENTER', dossier) %}
{% set status_keys = can_enter ? [{combo: 'N', verb: 'Nouveau mouvement'}] : [] %}

{% block page_head %}
    <twig:Px:PageHead title="Fiche de stock · {{ article.code }} {{ article.designation }}" :trail="[
        {label: 'Achats et stocks', href: path('app_inventory_articles', {dossier: dossier.id})},
        {label: 'Stocks', href: path('app_inventory_stock_state', {dossier: dossier.id})},
        {label: article.code, href: path('app_inventory_stock_card', {dossier: dossier.id, code: article.code})},
    ]">
        <twig:block name="actions">
            <twig:Px:Button href="{{ path('app_inventory_article', {dossier: dossier.id, code: article.code}) }}">Fiche article</twig:Px:Button>
            {% if can_enter %}<twig:Px:Button href="{{ path('app_inventory_stock_movement_new', {dossier: dossier.id, article: article.code}) }}" variant="primary" icon="plus" shortcut="N">Nouveau mouvement</twig:Px:Button>{% endif %}
        </twig:block>
    </twig:Px:PageHead>
{% endblock %}

{% block page %}
    <div class="px-kpis">
        <twig:Px:Kpi label="Quantité en stock" value="{{ card.closing.quantity|quantity(card.closing.quantity.strippedOfTrailingZeros.scale > 2 ? 3 : 2) ~ ' ' ~ article.unit }}" note="au {{ at|date_fr }}"/>
        <twig:Px:Kpi label="Valeur du stock" value="{{ card.closing.value|amount_eur }}" note="{{ article.valuationMethod.label }}"/>
        <twig:Px:Kpi label="Coût unitaire" value="{{ card.closing.unitCost ? card.closing.unitCost|amount_eur : '—' }}" note="valeur ÷ quantité"/>
        <twig:Px:Kpi label="Stock minimum" value="{{ article.minimumStock is not null ? article.minimumStock|quantity(article.minimumStock.strippedOfTrailingZeros.scale > 2 ? 3 : 2) ~ ' ' ~ article.unit : '—' }}" note="{{ article.minimumStock is not null and card.closing.quantity.isLessThan(article.minimumStock) ? 'en dessous : à réapprovisionner' : 'seuil d’alerte' }}" :state="article.minimumStock is not null and card.closing.quantity.isLessThan(article.minimumStock) ? 'alert' : null"/>
    </div>
    <twig:Px:Card :flush="true">
        <twig:Px:Filters action="{{ path('app_inventory_stock_card', {dossier: dossier.id, code: article.code}) }}" resetHref="{{ at != dossier.dossierDate ? path('app_inventory_stock_card', {dossier: dossier.id, code: article.code}) : null }}">
            <span class="px-filters__field">
                <label for="stock-at">Au</label>
                <twig:Px:DateInput id="stock-at" name="at" :value="at" :reference="dossier.dossierDate"/>
            </span>
            <twig:Px:Button type="submit" size="sm">Afficher</twig:Px:Button>
        </twig:Px:Filters>
        {% if card.rows is empty %}
            <twig:Px:Empty icon="package" title="Aucun mouvement" text="{{ article.code }} n’a aucun mouvement de stock au {{ at|date_fr }}."/>
        {% else %}
            <twig:Px:Table caption="Fiche de stock de {{ article.code }} au {{ at|date_fr }}">
                <thead>
                    <tr>
                        <th scope="col" rowspan="2">Date</th>
                        <th scope="col" rowspan="2">Libellé</th>
                        <th scope="col" rowspan="2">Dépôt</th>
                        <th scope="colgroup" colspan="3" class="px-u-num">Entrées</th>
                        <th scope="colgroup" colspan="3" class="px-u-num">Sorties</th>
                        <th scope="colgroup" colspan="3" class="px-u-num">Stock</th>
                    </tr>
                    <tr>
                        {% for part in ['Entrées', 'Sorties', 'Stock'] %}
                            <th scope="col" class="px-u-num">Qté</th>
                            <th scope="col" class="px-u-num">C. U.</th>
                            <th scope="col" class="px-u-num">Montant</th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for row in card.rows %}
                        {% set movement = movements_by_id[row.move.key] %}
                        <tr>
                            <td>{{ row.move.date|date_fr }}</td>
                            <td>
                                {% if movement.salesDocument %}<a class="px-link" href="{{ path('app_sales_document', {dossier: dossier.id, side: movement.salesDocument.type.side, id: movement.salesDocument.id}) }}">{{ movement.label }}</a>{% else %}{{ movement.label }}{% endif %}
                            </td>
                            <td>{{ movement.location }}{% if movement.toLocation %} → {{ movement.toLocation }} ({{ movement.quantity|quantity(movement.quantity.strippedOfTrailingZeros.scale > 2 ? 3 : 2) }}){% endif %}</td>
                            <td class="px-u-num">{{ row.inQuantity is not null ? row.inQuantity|quantity(row.inQuantity.strippedOfTrailingZeros.scale > 2 ? 3 : 2) : '' }}</td>
                            <td class="px-u-num">{{ row.inQuantity is not null and row.unitCost ? row.unitCost|amount : '' }}</td>
                            <td class="px-u-num">{{ row.inValue ? row.inValue|amount : '' }}</td>
                            <td class="px-u-num">{{ row.outQuantity is not null ? row.outQuantity|quantity(row.outQuantity.strippedOfTrailingZeros.scale > 2 ? 3 : 2) : '' }}</td>
                            <td class="px-u-num">{{ row.outQuantity is not null and row.unitCost ? row.unitCost|amount : '' }}</td>
                            <td class="px-u-num">{{ row.outValue ? row.outValue|amount : '' }}</td>
                            <td class="px-u-num">{{ row.balance.quantity|quantity(row.balance.quantity.strippedOfTrailingZeros.scale > 2 ? 3 : 2) }}</td>
                            <td class="px-u-num">{{ row.balance.unitCost ? row.balance.unitCost|amount : '' }}</td>
                            <td class="px-u-num">{{ row.balance.value|amount }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </twig:Px:Table>
        {% endif %}
    </twig:Px:Card>
    {% if article_places|length > 1 or (article_places|length == 1 and article_places[0].location != main_location) %}
        <twig:Px:Card title="Par dépôt au {{ at|date_fr }}">
            <dl class="px-facts">
                {% for place in article_places %}<dt>{{ place.location }}</dt><dd>{{ place.quantity|quantity(place.quantity.strippedOfTrailingZeros.scale > 2 ? 3 : 2) }} {{ article.unit }}</dd>{% endfor %}
            </dl>
        </twig:Px:Card>
    {% endif %}
{% endblock %}

{% block facts %}<span>{{ article.code }} · <b>{{ card.rows|length }}</b> mouvement{{ card.rows|length > 1 ? 's' : '' }}</span>{% endblock %}
