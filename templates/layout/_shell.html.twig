{#
 # The application shell shared by the student PGI and the teacher space (design-ui.md § 4.1,
 # design-ux.md §§ 2.1 and 2.4). Included by layout/pgi.html.twig and layout/teacher.html.twig with
 # the parts already rendered: rail, rail_foot, context_bar, topbar_start, topbar_search,
 # topbar_end, module_tabs, page_head, page, status, foot (HTML; a foot replaces the status bar), status_keys (list of {combo, verb}),
 # rail_home (the brand's link), rail_label.
 #}
<a class="px-skip" href="#main">Aller au contenu</a>
<div class="px-shell">
    <twig:Px:Rail :home="rail_home" :state="app.request.cookies.get('px_rail')" :label="rail_label">
        {{ rail }}
        <twig:block name="foot">{{ rail_foot }}</twig:block>
    </twig:Px:Rail>
    <div class="px-shell__col">
        {{ context_bar }}
        <twig:Px:TopBar>
            <twig:block name="start">{{ topbar_start }}</twig:block>
            {{ topbar_search }}
            <twig:block name="end">{{ topbar_end }}</twig:block>
        </twig:Px:TopBar>
        {{ module_tabs }}
        <main class="px-main" id="main" tabindex="-1" data-controller="scroll-shadow">
            {{ page_head }}
            <div class="px-page">{{ page }}</div>
        </main>
        {% if foot|trim is not empty %}
            {{ foot }}
        {% else %}
            <twig:Px:StatusBar :keys="status_keys">{{ status }}</twig:Px:StatusBar>
        {% endif %}
    </div>
</div>
{{ include('layout/_shortcuts_sheet.html.twig') }}
{{ include('layout/_small_screen.html.twig') }}
