{#
 # Bibliothèque › Nouveau dossier modèle › Depuis un FEC (design-ux.md § 3.3, gabarit E, step 2;
 # step 1.9b): the FEC of another tool, and the template's fields as for an empty one. The file
 # gives the plan's accounts, the journals, the third parties and the validated entries, lettered
 # as it says; a file with one anomaly is not imported, and its anomalies are listed line by line.
 #}
{% extends 'library/_layout.html.twig' %}

{% set library_tab = 'templates' %}
{% set library_title = 'Nouveau dossier modèle' %}
{% set status_keys = [{combo: 'F10', verb: 'Créer'}] %}

{% block page_head %}
    <twig:Px:PageHead title="Nouveau dossier modèle" :trail="[
        {label: 'Bibliothèque', href: path('app_library')},
        {label: 'Dossiers modèles', href: path('app_library')},
        {label: 'Nouveau dossier modèle', href: path('app_library_new')},
    ]">
        <twig:block name="actions">
            <twig:Px:Button variant="quiet" href="{{ path('app_library_new') }}">Retour</twig:Px:Button>
            <twig:Px:Button type="submit" variant="primary" form="new-template" shortcut="F10 Ctrl+S" icon="upload">Créer depuis le FEC</twig:Px:Button>
        </twig:block>
    </twig:Px:PageHead>
{% endblock %}

{% block page %}
    <twig:Px:Stepper label="Étapes du nouveau dossier modèle" :steps="[
        {label: 'Départ', href: path('app_library_new'), state: 'done'},
        {label: 'FEC, société, exercice et plan', href: path('app_library_new_fec'), state: 'current'},
    ]"/>

    <form method="post" action="{{ path('app_library_new_fec') }}" enctype="multipart/form-data" class="px-stack" id="new-template" data-turbo="false" novalidate data-controller="focus-error">
        <input type="hidden" name="_token" value="{{ csrf_token('library-new-fec') }}">
        {% if import.findings is not empty %}
            <twig:Px:Alert tone="danger" title="Rien n’est importé">{{ import.findings|length > 1 ? import.findings|length ~ ' anomalies' : 'Une anomalie' }} dans {{ import.fileName }} (détail ci-dessous) : corrigez le fichier, puis envoyez-le de nouveau. Un FEC n’est importé qu’en entier.</twig:Px:Alert>
        {% elseif form.errorCount > 0 or import.fileError %}
            {% set count = form.errorCount + (import.fileError ? 1 : 0) %}
            <twig:Px:Alert tone="danger">Le modèle n’est pas créé : {{ count > 1 ? count ~ ' champs sont à corriger' : 'un champ est à corriger' }}.</twig:Px:Alert>
        {% endif %}

        <twig:Px:Card title="Le FEC" meta="fichier des écritures comptables">
            <div class="px-fieldgrid">
                <twig:Px:Field id="file" label="Fichier FEC" :required="true" :wide="true" :error="import.fileError" hint="Le fichier d’un autre logiciel : dix-huit zones séparées par une tabulation ou « | », en UTF-8 ou ISO 8859-15. Ses comptes, journaux, tiers et écritures validées deviennent ceux du modèle ; ses dates tombent dans l’exercice ci-dessous.">
                    <input type="file" id="file" name="file" class="px-input" accept="{{ accept }}" aria-describedby="file_hint{{ import.fileError ? ' file_error' : '' }}"{% if import.fileError %} aria-invalid="true"{% endif %} required>
                </twig:Px:Field>
            </div>
        </twig:Px:Card>

        {{ include('library/_template_fields.html.twig') }}
    </form>

    {% if import.findings is not empty %}
        {{ include('closing/_fec_findings.html.twig', {findings: import.findings}) }}
    {% endif %}
{% endblock %}

{% block facts %}<span>Étape · <b>2 sur 2</b></span>{% endblock %}
