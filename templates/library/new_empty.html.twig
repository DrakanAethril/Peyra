{#
 # Bibliothèque › Nouveau dossier modèle › Dossier vide (design-ux.md § 3.3, gabarit E, step 2): the
 # card's title, the company's fiche, the first exercise, the dossier's date and the reference
 # chart (the latest whose date has come for the exercise, by default). « Créer » (F10).
 #}
{% extends 'library/_layout.html.twig' %}

{% set library_tab = 'templates' %}
{% set library_title = 'Nouveau dossier modèle' %}
{% set status_keys = [{combo: 'F10', verb: 'Créer'}] %}

{% block page_head %}
    <twig:Px:PageHead title="Nouveau dossier modèle" :trail="[
        {label: 'Bibliothèque', href: path('app_library')},
        {label: 'Dossiers modèles', href: path('app_library')},
        {label: 'Nouveau dossier modèle', href: path('app_library_new')},
    ]">
        <twig:block name="actions">
            <twig:Px:Button variant="quiet" href="{{ path('app_library_new') }}">Retour</twig:Px:Button>
            <twig:Px:Button type="submit" variant="primary" form="new-template" shortcut="F10 Ctrl+S" icon="plus">Créer le modèle</twig:Px:Button>
        </twig:block>
    </twig:Px:PageHead>
{% endblock %}

{% block page %}
    <twig:Px:Stepper label="Étapes du nouveau dossier modèle" :steps="[
        {label: 'Départ', href: path('app_library_new'), state: 'done'},
        {label: 'Société, exercice et plan', href: path('app_library_new_empty'), state: 'current'},
    ]"/>

    <form method="post" action="{{ path('app_library_new_empty') }}" class="px-stack" id="new-template" novalidate data-controller="focus-error">
        <input type="hidden" name="_token" value="{{ csrf_token('library-new-empty') }}">
        {% if form.errorCount > 0 %}
            <twig:Px:Alert tone="danger">Le modèle n’est pas créé : {{ form.errorCount > 1 ? form.errorCount ~ ' champs sont à corriger' : 'un champ est à corriger' }}.</twig:Px:Alert>
        {% endif %}

        {{ include('library/_template_fields.html.twig') }}
    </form>
{% endblock %}

{% block facts %}<span>Étape · <b>2 sur 2</b></span>{% endblock %}
