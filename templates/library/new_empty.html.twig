{#
 # Bibliothèque › Nouveau dossier modèle › Dossier vide (design-ux.md § 3.3, gabarit E, step 2): the
 # card's title, the company's fiche, the first exercise, the dossier's date and the reference
 # chart (the latest whose date has come for the exercise, by default). « Créer » (F10).
 #}
{% extends 'library/_layout.html.twig' %}

{% set library_tab = 'templates' %}
{% set library_title = 'Nouveau dossier modèle' %}
{% set status_keys = [{combo: 'F10', verb: 'Créer'}] %}

{% block page_head %}
    <twig:Px:PageHead title="Nouveau dossier modèle" :trail="[
        {label: 'Bibliothèque', href: path('app_library')},
        {label: 'Dossiers modèles', href: path('app_library')},
        {label: 'Nouveau dossier modèle', href: path('app_library_new')},
    ]">
        <twig:block name="actions">
            <twig:Px:Button variant="quiet" href="{{ path('app_library_new') }}">Retour</twig:Px:Button>
            <twig:Px:Button type="submit" variant="primary" form="new-template" shortcut="F10 Ctrl+S" icon="plus">Créer le modèle</twig:Px:Button>
        </twig:block>
    </twig:Px:PageHead>
{% endblock %}

{% block page %}
    <twig:Px:Stepper label="Étapes du nouveau dossier modèle" :steps="[
        {label: 'Départ', href: path('app_library_new'), state: 'done'},
        {label: 'Société, exercice et plan', href: path('app_library_new_empty'), state: 'current'},
    ]"/>

    <form method="post" action="{{ path('app_library_new_empty') }}" class="px-stack" id="new-template" novalidate data-controller="focus-error">
        <input type="hidden" name="_token" value="{{ csrf_token('library-new-empty') }}">
        {% if form.errorCount > 0 %}
            <twig:Px:Alert tone="danger">Le modèle n’est pas créé : {{ form.errorCount > 1 ? form.errorCount ~ ' champs sont à corriger' : 'un champ est à corriger' }}.</twig:Px:Alert>
        {% endif %}

        <twig:Px:Card title="Le modèle" meta="dans la bibliothèque">
            <div class="px-fieldgrid">
                <twig:Px:Field id="title" label="Titre" :wide="true" hint="Vide : le nom de la société." :error="form.error('title')">
                    <twig:Px:Input id="title" value="{{ form.title }}" hint="1" :error="form.error('title')" maxlength="120" autocomplete="off" placeholder="Vasseur, à-nouveaux 2026"/>
                </twig:Px:Field>
            </div>
        </twig:Px:Card>

        {{ include('dossier/_company_fields.html.twig') }}

        <twig:Px:Card title="Exercice et plan de comptes">
            <div class="px-fieldgrid">
                <twig:Px:Field id="exerciseStart" label="Début de l’exercice" :required="true" :error="form.error('exerciseStart')">
                    <twig:Px:DateInput id="exerciseStart" :value="dates.exerciseStart" :reference="reference" :required="true" :error="form.error('exerciseStart')"/>
                </twig:Px:Field>
                <twig:Px:Field id="exerciseEnd" label="Fin de l’exercice" :required="true" hint="Un exercice dure de 1 à 24 mois." :error="form.error('exerciseEnd')">
                    <twig:Px:DateInput id="exerciseEnd" :value="dates.exerciseEnd" :reference="reference" :required="true" hint="1" :error="form.error('exerciseEnd')"/>
                </twig:Px:Field>
                <twig:Px:Field id="dossierDate" label="Date du dossier" :required="true" hint="Le jour où le dossier commence ; vous l’avancez ensuite." :error="form.error('dossierDate')">
                    <twig:Px:DateInput id="dossierDate" :value="dates.dossierDate" :reference="reference" :required="true" hint="1" :error="form.error('dossierDate')"/>
                </twig:Px:Field>
                <twig:Px:Field id="chart" label="Plan de comptes de référence" :required="true" :wide="true" :error="form.error('chart')">
                    <twig:Px:Select id="chart" placeholder="Choisir un plan…" :options="charts" value="{{ form.chart }}" :required="true" :error="form.error('chart')"/>
                </twig:Px:Field>
            </div>
        </twig:Px:Card>
    </form>
{% endblock %}

{% block facts %}<span>Étape · <b>2 sur 2</b></span>{% endblock %}
