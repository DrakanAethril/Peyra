{#
 # Bibliothèque (design-ux.md § 2.6): « Dossiers modèles » and « Partages »; « Missions » and
 # « Distribution » join it with their steps (2.9, 1.8c). A screen sets `library_tab` and
 # `library_title` outside any block.
 #}
{% extends 'teacher/_layout.html.twig' %}

{% set rail_current = 'bibliotheque' %}

{% block title %}{{ library_title }} · Bibliothèque · Peyra{% endblock %}

{% block module_tabs %}
    <twig:Px:ModuleTabs label="Bibliothèque" :tabs="[
        {label: 'Dossiers modèles', href: path('app_library'), current: library_tab == 'templates'},
        {label: 'Partages', href: path('app_library_shares'), current: library_tab == 'shares'},
    ]"/>
{% endblock %}

{% block status %}
    {%- for message in app.flashes('status') %}<span>{{ message }}</span>{% else %}{{ block('facts') }}{% endfor -%}
{% endblock %}

{% block facts %}{% endblock %}
