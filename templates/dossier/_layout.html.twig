{#
 # The PGI inside a dossier (design-ux.md § 2.1): the rail of its modules, the switcher, the global
 # search (Ctrl K), the date chip and - in a group's dossier - the member's profile chip in the top bar, and, for a teacher, the ribbon that says whose dossier this is (C4). Only the
 # modules that exist are in the rail: Banque, Fiscalité and the others arrive with their steps.
 # A screen sets `rail_current` (dashboard, documents, sales, inventory, accounting, closing, payroll, si) and `dossier_title` outside
 # any block, and fills page_head, page, module_tabs and `facts` (the status bar without a message).
 #}
{% extends 'layout/pgi.html.twig' %}

{% set view = dossier_shell(dossier) %}
{% set rail_home = path('app_dossier_dashboard', {dossier: dossier.id}) %}

{% block title %}{{ dossier_title }} · {{ dossier.name }} · Peyra{% endblock %}

{% block rail %}
    <twig:Px:RailItem href="{{ path('app_dossier_dashboard', {dossier: dossier.id}) }}" icon="house" label="Tableau de bord" :current="(rail_current ?? '') == 'dashboard'"/>
    <twig:Px:RailItem href="{{ path('app_documents', {dossier: dossier.id}) }}" icon="inbox" label="Pièces" :current="(rail_current ?? '') == 'documents'" :count="view.documentsToProcess" countLabel="{{ view.documentsToProcess }} pièce{{ view.documentsToProcess > 1 ? 's' : '' }} à traiter"/>
    <twig:Px:RailGroup label="Gestion">
        {% if is_granted('SALES_READ', dossier) %}<twig:Px:RailItem href="{{ path('app_sales_documents', {dossier: dossier.id, side: 'sales', type: 'quote'}) }}" icon="tag" label="Ventes" :current="(rail_current ?? '') == 'sales'"/>{% endif %}
        <twig:Px:RailItem href="{{ is_granted('PURCHASES_READ', dossier) ? path('app_sales_documents', {dossier: dossier.id, side: 'purchases', type: 'purchase_order'}) : path('app_inventory_articles', {dossier: dossier.id}) }}" icon="package" label="Achats et stocks" :current="(rail_current ?? '') == 'inventory'"/>
    </twig:Px:RailGroup>
    <twig:Px:RailGroup label="Comptabilité">
        <twig:Px:RailItem href="{{ path('app_accounting_entry', {dossier: dossier.id}) }}" icon="book-text" label="Comptabilité" :current="(rail_current ?? '') == 'accounting'"/>
        <twig:Px:RailItem href="{{ path('app_closing_fec', {dossier: dossier.id}) }}" icon="lock" label="Immobilisations et clôture" :current="(rail_current ?? '') == 'closing'"/>
        {% if is_granted('PAYROLL_READ', dossier) %}<twig:Px:RailItem href="{{ path('app_payroll_employees', {dossier: dossier.id}) }}" icon="users" label="Paie et social" :current="(rail_current ?? '') == 'payroll'"/>{% endif %}
    </twig:Px:RailGroup>
    <twig:Px:RailGroup label="Analyse">
        <twig:Px:RailItem href="{{ path('app_dossier_company', {dossier: dossier.id}) }}" icon="database" label="Système d’information" :current="(rail_current ?? '') == 'si'"/>
    </twig:Px:RailGroup>
{% endblock %}

{% block context_bar %}
    {% if view.teacher %}
        {% if dossier.template %}
            <twig:Px:ContextBar tone="template" backLabel="Revenir à la bibliothèque" backHref="{{ path('app_library_template', {dossier: dossier.id}) }}">Dossier modèle · {{ dossier.libraryTitle }}{% if dossier.owner is null %} · bibliothèque commune{% endif %}{% if view.canEdit %} · vos modifications valent pour les prochaines distributions{% endif %}</twig:Px:ContextBar>
        {% elseif view.holders|length == 1 %}
            <twig:Px:ContextBar backLabel="Revenir à la fiche de l’étudiant" backHref="{{ path('app_teacher_student', {id: view.holders[0].id}) }}">Dossier de {{ view.holderNames }} · {{ view.canEdit ? 'vos actions sont signées de votre nom' : 'en lecture' }}</twig:Px:ContextBar>
        {% else %}
            <twig:Px:ContextBar backLabel="Revenir à l’accueil" backHref="{{ path('app_teacher_home') }}">Dossier du groupe {{ view.holderNames }} · {{ view.canEdit ? 'vos actions sont signées de votre nom' : 'en lecture' }}</twig:Px:ContextBar>
        {% endif %}
    {% endif %}
{% endblock %}

{% block topbar_start %}{{ include('dossier/_switcher.html.twig') }}{% endblock %}

{% block topbar_search %}<twig:Px:CommandPalette src="{{ path('app_dossier_search', {dossier: dossier.id}) }}"/>{% endblock %}

{% block topbar_end %}
    <span hidden data-controller="dossier-live" data-dossier-live-url-value="{{ dossier_live_url(dossier) }}" data-dossier-live-waiting-value="{{ path('app_dossier_restoring', {dossier: dossier.id}) }}"></span>
    {{ include('dossier/_date_chip.html.twig') }}
    {% if view.profile %}<twig:Px:Chip tone="role" icon="user" title="Votre profil dans ce dossier de groupe : {{ view.profile.description }}">{{ view.profile.label }}</twig:Px:Chip>{% endif %}
    {{ include('layout/_user_menu.html.twig') }}
{% endblock %}

{% block status %}
    {%- for message in app.flashes('status') %}<span>{{ message }}</span>{% else %}{% if view.dateMoved %}<span>Votre enseignant a fixé la date du dossier au <b>{{ dossier.dossierDate|date_fr }}</b></span>{% else %}{{ block('facts') }}{% endif %}{% endfor -%}
{% endblock %}

{% block facts %}
    <span>Date du dossier · <b>{{ dossier.dossierDate|date_fr }}</b></span>
    {% if view.period %}<span>Période · <b>{{ view.period.label }}</b>{{ view.period.closed ? ' (close)' : '' }}</span>{% endif %}
{% endblock %}
