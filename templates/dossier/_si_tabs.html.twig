    {label: 'Utilisateurs et droits', href: path('app_dossier_users', {dossier: dossier.id}), current: si_current == 'users'},
    {label: 'Piste d’audit', href: path('app_dossier_audit', {dossier: dossier.id}), current: si_current == 'audit'},
    {label: 'Points de restauration', href: path('app_dossier_restore_points', {dossier: dossier.id}), current: si_current == 'restore'},
]"/>
