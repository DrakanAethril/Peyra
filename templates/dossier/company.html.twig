{#
 # Système d'information › Société (design-ux.md § 3.2, gabarit F): identity and regimes, saved with
 # F10 by whoever works in the dossier; the exercises and their periods below, read only (they open
 # and close with the closing screens). A person who only reads sees the same fiche, without fields.
 #}
{% extends 'dossier/_layout.html.twig' %}

{% set rail_current = 'si' %}
{% set dossier_title = 'Société' %}
{% set status_keys = is_granted('DOSSIER_EDIT', dossier) ? [{combo: 'F10', verb: 'Enregistrer'}] : [] %}

{% block module_tabs %}
    <twig:Px:ModuleTabs label="Système d’information" :tabs="[
        {label: 'Société', href: path('app_dossier_company', {dossier: dossier.id}), current: true},
    ]"/>
{% endblock %}

{% block page_head %}
    <twig:Px:PageHead title="{{ dossier.name }}" :trail="[
        {label: 'Système d’information', href: path('app_dossier_company', {dossier: dossier.id})},
        {label: 'Société', href: path('app_dossier_company', {dossier: dossier.id})},
    ]">
        <twig:block name="actions">
            {% if view.canEdit %}<twig:Px:Button type="submit" variant="primary" form="company-form" shortcut="F10 Ctrl+S">Enregistrer</twig:Px:Button>{% endif %}
        </twig:block>
    </twig:Px:PageHead>
{% endblock %}

{% block page %}
    {% if view.canEdit %}
        {{ include('dossier/_company_form.html.twig') }}
    {% else %}
        {{ include('dossier/_company_facts.html.twig') }}
    {% endif %}

    <twig:Px:Card :flush="true" title="Exercices" meta="ouverts et clos à la clôture" id="exercices">
        {% if exercises is empty %}
            <twig:Px:Empty icon="calendar" title="Aucun exercice" text="Un exercice s’ouvre avec le dossier ou à la clôture du précédent."/>
        {% else %}
            <twig:Px:Table caption="Exercices de {{ dossier.name }}">
                <thead>
                    <tr>
                        <th scope="col">Exercice</th>
                        <th scope="col">Du</th>
                        <th scope="col">Au</th>
                        <th scope="col">État</th>
                        <th scope="col">Périodes</th>
                    </tr>
                </thead>
                <tbody>
                    {% for exercise in exercises %}
                        {% set exercise_periods = periods[exercise.id] ?? [] %}
                        {% set closed = exercise_periods|filter(p => p.closed)|length %}
                        <tr{% if view.exercise == exercise %} class="is-current"{% endif %}>
                            <th scope="row">{{ exercise.code }}{% if view.exercise == exercise %} <span class="px-u-sr-only">(exercice de la date du dossier)</span>{% endif %}</th>
                            <td>{{ exercise.startsOn|date_fr }}</td>
                            <td>{{ exercise.endsOn|date_fr }}</td>
                            <td><twig:Px:Badge tone="{{ exercise.closed ? 'neutral' : 'info' }}" label="{{ exercise.closed ? 'Clos' : 'Ouvert' }}"/></td>
                            <td>
                                <span class="px-periods" aria-label="{{ exercise_periods|length }} périodes, {{ closed }} closes">
                                    {% for period in exercise_periods %}
                                        <span class="px-periods__month{{ period.closed ? ' is-closed' : '' }}{{ view.period == period ? ' is-current' : '' }}" title="{{ period.label }}, {{ period.closed ? 'close' : 'ouverte' }}" aria-hidden="true"></span>
                                    {% endfor %}
                                </span>
                                <small class="px-u-muted">{{ exercise_periods|length }} {{ exercise_periods|length > 1 ? 'périodes' : 'période' }}, {{ closed }} {{ closed > 1 ? 'closes' : 'close' }}</small>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </twig:Px:Table>
        {% endif %}
    </twig:Px:Card>
{% endblock %}
