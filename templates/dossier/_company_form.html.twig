{#
 # The fiche société's fields (design-ux.md § 3.1, gabarit F: label above, an error under its
 # field). Posted to the same address; F10 saves (the page head's button).
 #}
<form method="post" action="{{ path('app_dossier_company', {dossier: dossier.id}) }}" class="px-stack" id="company-form" novalidate data-controller="focus-error">
    <input type="hidden" name="_token" value="{{ csrf_token('dossier-company-' ~ dossier.id) }}">
    {% if draft.errors is not empty %}
        <twig:Px:Alert tone="danger">La fiche n’est pas enregistrée : {{ draft.errors|length > 1 ? draft.errors|length ~ ' champs sont à corriger' : 'un champ est à corriger' }}.</twig:Px:Alert>
    {% endif %}

    {{ include('dossier/_company_fields.html.twig') }}
</form>
