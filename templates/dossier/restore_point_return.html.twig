{#
 # « Revenir à ce point » (design-ux.md § 4.9, step 2; § 6.2: gabarit E, one step, « qui compte ce
 # qui change »): what the dossier holds now against what the point holds, the gestures of the
 # trail made since the point, what stays (the dossier's date, the trail, the other points), the
 # box « Poser d'abord un point de l'état actuel » ticked - unless the dossier has its ten points -,
 # then « Revenir au point » (Ctrl Entrée). The return itself runs behind the waiting page.
 #}
{% extends 'dossier/_layout.html.twig' %}

{% set rail_current = 'si' %}
{% set dossier_title = 'Revenir à un point' %}
{% set points_url = path('app_dossier_restore_points', {dossier: dossier.id}) %}
{% set return_url = path('app_dossier_restore_point_return', {dossier: dossier.id, point: point.id}) %}
{% set status_keys = [{combo: 'Ctrl+Enter', verb: 'Revenir au point'}] %}

{% block module_tabs %}{% set si_current = 'restore' %}{{ include('dossier/_si_tabs.html.twig') }}{% endblock %}

{% block page_head %}
    <twig:Px:PageHead title="Revenir au point « {{ point.name }} »" :trail="[
        {label: 'Système d’information', href: path('app_dossier_company', {dossier: dossier.id})},
        {label: 'Points de restauration', href: points_url},
        {label: point.name, href: return_url},
    ]">
        <twig:block name="actions">
            <twig:Px:Button variant="quiet" href="{{ points_url }}">Annuler</twig:Px:Button>
            <twig:Px:Button type="submit" variant="primary" form="restore-return" icon="undo-2" shortcut="Ctrl+Enter">Revenir au point</twig:Px:Button>
        </twig:block>
    </twig:Px:PageHead>
{% endblock %}

{% block page %}
    <twig:Px:Stepper label="Retour à un point de restauration" :steps="[{label: 'Récapitulatif', href: return_url, state: 'current'}]"/>

    {% if error %}<twig:Px:Alert tone="danger">{{ error }}</twig:Px:Alert>{% endif %}

    <div class="px-split">
        <twig:Px:Card title="Ce qui sera perdu" meta="tout ce qui a été fait depuis ce point">
            <p class="px-restore-lead">
                Le dossier reprend son état du <b>{{ point.createdAt|date('d/m/Y à H:i') }}</b> (date du dossier : {{ point.dossierDate|date_fr }}).
                {% if summary.gestures > 0 %}
                    <b>{{ summary.gestures }}</b> {{ summary.gestures > 1 ? 'gestes faits depuis seront défaits' : 'geste fait depuis sera défait' }}.
                {% else %}
                    Aucun geste n’a été fait depuis.
                {% endif %}
            </p>
            <twig:Px:Table class="px-restore-summary" caption="Contenu du dossier maintenant et au point « {{ point.name }} »" variant="plain" density="compact">
                <thead><tr>
                    <th scope="col">Élément</th>
                    <th scope="col" class="px-u-right">Maintenant</th>
                    <th scope="col" class="px-u-right">Au point</th>
                </tr></thead>
                <tbody>
                    {% for row in summary.rows %}
                        <tr{% if row.now != row.point %} class="px-restore-changed"{% endif %}>
                            <th scope="row">{{ row.label }}{% if row.now != row.point %}<span class="px-u-sr-only"> (change)</span>{% endif %}</th>
                            <td class="px-u-num">{{ row.now }}</td>
                            <td class="px-u-num">{{ row.point }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </twig:Px:Table>
        </twig:Px:Card>
        <twig:Px:Card title="Ce qui reste">
            <ul class="px-recap">
                <li>La date du dossier : <b>{{ dossier.dossierDate|date_fr }}</b>. Seul votre enseignant la déplace.</li>
                <li>La piste d’audit, entière, avec une ligne de plus pour ce retour.</li>
                <li>Les autres points de restauration, et celui-ci : vous pourrez y revenir encore.</li>
            </ul>
        </twig:Px:Card>
    </div>

    <form method="post" action="{{ return_url }}" id="restore-return" novalidate>
        <input type="hidden" name="_token" value="{{ csrf_token('restore-point-return-' ~ point.id) }}">
        <twig:Px:Card title="Avant de revenir">
            <label class="px-check">
                <input type="checkbox" name="keep" value="1"{% if keep %} checked{% endif %}{% if full %} disabled aria-describedby="keep_hint"{% endif %}>
                <span>Poser d’abord un point de l’état actuel, pour pouvoir y revenir</span>
            </label>
            {% if full %}<p class="px-field__hint" id="keep_hint">Ce dossier a déjà 10 points : supprimez-en un pour garder l’état actuel.</p>{% endif %}
            <p class="px-field__hint">Pendant le retour, le dossier affiche une page d’attente dans tous ses onglets ouverts, puis les recharge.</p>
        </twig:Px:Card>
    </form>
{% endblock %}

{% block facts %}<span>Point · <b>{{ point.name }}</b></span><span>Éléments qui changent · <b>{{ summary.changed }}</b></span>{% endblock %}
