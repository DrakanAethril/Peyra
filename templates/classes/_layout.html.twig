{#
 # Classes (design-ux.md § 2.6): « Classes de l'année », « À placer », « Passage de classe »,
 # « Années précédentes ». A screen sets `classes_tab` and `classes_title` outside any block.
 #}
{% extends 'teacher/_layout.html.twig' %}

{% set rail_current = 'classes' %}

{% block title %}{{ classes_title }} · Classes · Peyra{% endblock %}

{% block module_tabs %}
    {% set unplaced = unplaced_count() %}
    <twig:Px:ModuleTabs label="Classes" :tabs="[
        {label: 'Classes de l’année', href: path('app_teacher_classes'), current: classes_tab == 'year'},
        {label: unplaced > 0 ? 'À placer · ' ~ unplaced : 'À placer', href: path('app_teacher_unplaced'), current: classes_tab == 'unplaced'},
        {label: 'Passage de classe', href: path('app_teacher_promotion'), current: classes_tab == 'promotion'},
        {label: 'Années précédentes', href: path('app_teacher_classes_past'), current: classes_tab == 'past'},
    ]"/>
{% endblock %}

{% block status %}
    {%- for message in app.flashes('status') %}<span>{{ message }}</span>{% else %}{{ block('facts') }}{% endfor -%}
{% endblock %}

{% block facts %}{% endblock %}
