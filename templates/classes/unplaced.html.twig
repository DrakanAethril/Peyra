{#
 # Classes › À placer (design-ux.md § 3.3, gabarit L; § 4.1, step 5): the students without a class
 # in the current year, what the directory said when their account was created, their last known
 # class. Ticked rows bring the lot actions: choose the class, « Placer la sélection »; or mark them
 # as having left the field. The « Sortis de la filière » filter lists those, to put back.
 #}
{% extends 'classes/_layout.html.twig' %}

{% set classes_tab = 'unplaced' %}
{% set classes_title = 'À placer' %}

{% block page_head %}
    <twig:Px:PageHead title="À placer" :trail="[{label: 'Classes', href: path('app_teacher_classes')}]">
        <twig:block name="badge">{% if year %}<twig:Px:Chip>{{ year.label }}</twig:Px:Chip>{% endif %}</twig:block>
    </twig:Px:PageHead>
{% endblock %}

{% block page %}
    {% if year is null or classes is empty %}
        {{ include('classes/_no_year.html.twig') }}
    {% else %}
        <twig:Px:Card :flush="true">
            <form method="post" action="{{ path(departed ? 'app_teacher_unplaced_restore' : 'app_teacher_unplaced_place') }}"
                  data-controller="selection" data-selection-one-value="%d étudiant coché" data-selection-many-value="%d étudiants cochés"
                  data-action="change->selection#refresh">
                <input type="hidden" name="_token" value="{{ csrf_token('unplaced') }}">
                <div class="px-filters" data-selection-target="idle">
                    <twig:Px:FilterChip label="À placer" :count="counts.waiting" href="{{ path('app_teacher_unplaced') }}" :current="not departed"/>
                    <twig:Px:FilterChip label="Sortis de la filière" :count="counts.departed" href="{{ path('app_teacher_unplaced', {show: 'departed'}) }}" :current="departed"/>
                </div>
                <div class="px-lotbar" data-selection-target="bar" hidden>
                    <span class="px-lotbar__count" data-selection-target="count" aria-live="polite"></span>
                    {% if departed %}
                        <twig:Px:Button type="submit" size="sm" variant="primary" icon="undo-2">Remettre à placer</twig:Px:Button>
                    {% else %}
                        <label class="px-u-sr-only" for="place-class">Classe</label>
                        <twig:Px:Select id="place-class" name="class" size="sm" placeholder="Choisir la classe…" :options="classes|map(r => {value: r.schoolClass.id, label: r.schoolClass.name ~ ' · ' ~ r.students ~ (r.students > 1 ? ' étudiants' : ' étudiant')})"/>
                        <twig:Px:Button type="submit" size="sm" variant="primary" icon="user-plus">Placer la sélection</twig:Px:Button>
                        <twig:Px:ConfirmButton label="Sortis de la filière" confirmLabel="Confirmer la sortie" variant="secondary" size="sm" formaction="{{ path('app_teacher_unplaced_depart') }}" aria-describedby="unplaced-note"/>
                    {% endif %}
                </div>
                {% if students is empty %}
                    {% if departed %}
                        <twig:Px:Empty icon="users" title="Aucun étudiant sorti de la filière" text="Un étudiant marqué sorti quitte « À placer » ; il garde son compte et ses dossiers."/>
                    {% else %}
                        <twig:Px:Empty icon="users" title="Personne à placer" text="Chaque étudiant a sa classe en {{ year.label }}."/>
                    {% endif %}
                {% else %}
                    <twig:Px:Table caption="{{ departed ? 'Étudiants sortis de la filière' : 'Étudiants sans classe en ' ~ year.label }}" :rows="true">
                        <thead>
                            <tr>
                                <th scope="col" class="px-table__pick">
                                    <label class="px-check"><input type="checkbox" data-selection-target="all" data-action="selection#toggleAll"><span class="px-u-sr-only">Tout cocher</span></label>
                                </th>
                                <th scope="col">Nom</th>
                                <th scope="col">Identifiant</th>
                                <th scope="col">Groupes lus à la création</th>
                                <th scope="col">Dernière classe connue</th>
                                <th scope="col">{{ departed ? 'Sorti' : 'Dernière connexion' }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for student in students %}
                                {% set last = latest[student.id] ?? null %}
                                <tr data-rows-target="row">
                                    <td class="px-table__pick">
                                        <label class="px-check"><input type="checkbox" name="students[]" value="{{ student.id }}" data-selection-target="box"><span class="px-u-sr-only">Cocher {{ student.sortName }}</span></label>
                                    </td>
                                    <td><a class="px-link" href="{{ path('app_teacher_student', {id: student.id}) }}">{{ student.sortName }}</a></td>
                                    <td class="px-u-code">{{ student.login }}</td>
                                    <td>
                                        <span class="px-u-code">{{ student.groupsAtCreation|filter(g => g not in ['student', 'teacher'])|join(', ') ?: '—' }}</span>
                                        {% if student.initialPlacement and student.initialPlacement.value != 'placed' and last is null %}<br><span class="px-u-muted">{{ student.initialPlacement.label }}</span>{% endif %}
                                    </td>
                                    <td>{% if last %}<a class="px-link" href="{{ path('app_teacher_class', {id: last.schoolClass.id}) }}">{{ last.schoolClass.label }}</a>{% else %}<span class="px-u-muted">Aucune</span>{% endif %}</td>
                                    <td>
                                        {% if departed %}
                                            {{ student.departedAt|date('d/m/Y') }}{% if student.departedBy %}, par {{ student.departedBy.displayName }}{% endif %}
                                        {% else %}
                                            {{ student.lastLoginAt ? student.lastLoginAt|date('d/m/Y à H \\h i') : 'Jamais connecté' }}
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </twig:Px:Table>
                {% endif %}
            </form>
            <twig:block name="foot">
                {% if not departed and students is not empty %}
                    <p class="px-u-muted" id="unplaced-note">Cochez des étudiants, choisissez la classe, puis « Placer la sélection ». Un étudiant sorti de la filière quitte cette liste ; il garde son compte et ses dossiers, et y revient s’il se reconnecte.</p>
                {% endif %}
            </twig:block>
        </twig:Px:Card>
    {% endif %}
{% endblock %}

{% block facts %}{% if year %}<span>{{ year.label }}</span><span>À placer · <b>{{ counts.waiting }}</b></span>{% endif %}{% endblock %}
