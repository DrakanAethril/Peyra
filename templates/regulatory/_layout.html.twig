{#
 # Paramètres › Paramètres réglementaires (design-ux.md §§ 2.6 and 3.3): every teacher reads them,
 # administrators add dated values. A screen sets `regulatory_title` outside any block.
 #}
{% extends 'teacher/_layout.html.twig' %}

{% set rail_current = 'parametres' %}

{% block title %}{{ regulatory_title }} · Paramètres · Peyra{% endblock %}

{% block module_tabs %}{{ include('teacher/_settings_tabs.html.twig', {settings_tab: 'regulatory'}) }}{% endblock %}

{% block status %}
    {%- for message in app.flashes('status') %}<span>{{ message }}</span>{% else %}{{ block('facts') }}{% endfor -%}
{% endblock %}

{% block facts %}{% endblock %}
