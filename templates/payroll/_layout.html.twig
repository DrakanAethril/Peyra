{#
 # Paie et social (design-ux.md §§ 2.5 and 3.2; lot 4): the module's tab bar - Salariés (step 4.2a),
 # Bulletins (step 4.4a) and « Paramètres de paie » (step 4.1: plan de paie, organismes, établissement); Éditions,
 # Déclarations, Écritures de paie and Fin de contrat join it with their steps. A screen
 # sets `payroll_tab` ('employees', 'payslips', else the settings), `settings_current` and `dossier_title`
 # outside any block. Closed to a profile that does not read the payroll (PAYROLL_READ).
 #}
{% extends 'dossier/_layout.html.twig' %}

{% set rail_current = 'payroll' %}

{% block module_tabs %}
    <twig:Px:ModuleTabs label="Paie et social" :tabs="[
        {label: 'Salariés', href: path('app_payroll_employees', {dossier: dossier.id}), current: (payroll_tab ?? '') == 'employees'},
        {label: 'Bulletins', href: path('app_payroll_payslips', {dossier: dossier.id}), current: (payroll_tab ?? '') == 'payslips'},
        {label: 'Paramètres de paie', href: path('app_payroll_items', {dossier: dossier.id}), current: (payroll_tab ?? '') not in ['employees', 'payslips']},
    ]"/>
{% endblock %}
