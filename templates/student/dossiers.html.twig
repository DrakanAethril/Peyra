{#
 # « Mes dossiers » (design-ux.md § 3.2, gabarit L en cartes; § 4.1, steps 3 and 4): the student's
 # dossiers by school year, the most recent first - a card each, with its exercise, its date and the
 # last visit; « Ouvrir » leads to its dashboard. Empty until a teacher distributes one.
 #}
{% extends 'student/_layout.html.twig' %}

{% set rail_current = 'dossiers' %}
{% set count = groups|reduce((sum, g) => sum + g.rows|length, 0) %}

{% block title %}Mes dossiers · Peyra{% endblock %}

{% block page_head %}
    <twig:Px:PageHead title="Mes dossiers">
        <twig:block name="badge">{% if enrolment %}<twig:Px:Chip>{{ enrolment.schoolClass.label }}</twig:Px:Chip>{% endif %}</twig:block>
    </twig:Px:PageHead>
{% endblock %}

{% block page %}
    {% if enrolment is null %}
        <twig:Px:Alert tone="warning">Vous n’êtes dans aucune classe pour le moment. Un enseignant va vous placer ; vous n’avez rien à faire.</twig:Px:Alert>
    {% endif %}
    {% if groups is empty %}
        <twig:Px:Card>
            <twig:Px:Empty :page="true" icon="folder-open" title="Aucun dossier pour l’instant" text="Votre enseignant vous en distribuera un ; il apparaîtra ici."/>
        </twig:Px:Card>
    {% else %}
        {% for group in groups %}
            <h2 class="px-dossiers__year">{{ group.year }}</h2>
            <div class="px-dossiers">
                {% for row in group.rows %}
                    {% set dossier_row = row.dossier %}
                    <twig:Px:Card title="{{ dossier_row.name }}" meta="{{ row.exercise ? 'Exercice ' ~ row.exercise.code : 'Hors exercice' }}">
                        <twig:block name="actions">{% if dossier_row.kind.value != 'student' %}<twig:Px:Badge :of="dossier_row.kind"/>{% endif %}</twig:block>
                        <dl class="px-facts">
                            <dt>Date du dossier</dt><dd>{{ dossier_row.dossierDate|date_chip }}</dd>
                            <dt>Activité</dt><dd>{% set activity = dossier_row.company.activity %}{{ activity|length > 90 ? activity|slice(0, 89)|trim ~ '…' : activity }}</dd>
                            <dt>Dernier passage</dt><dd>{{ dossier_row.lastVisitedAt ? 'le ' ~ dossier_row.lastVisitedAt|date('d/m/Y') ~ ' à ' ~ dossier_row.lastVisitedAt|clock : 'jamais ouvert' }}</dd>
                        </dl>
                        <twig:block name="foot"><twig:Px:Button variant="primary" size="sm" href="{{ path('app_dossier_dashboard', {dossier: dossier_row.id}) }}" icon="folder-open">Ouvrir</twig:Px:Button></twig:block>
                    </twig:Px:Card>
                {% endfor %}
            </div>
        {% endfor %}
    {% endif %}
{% endblock %}

{% block status %}<span>Dossiers · <b>{{ count > 0 ? count : 'aucun' }}</b></span>{% if enrolment %}<span>Classe · <b>{{ enrolment.schoolClass.label }}</b></span>{% endif %}{% endblock %}
