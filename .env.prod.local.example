# Template for .env.prod.local, on the production server only (docs/production.md):
#
#   cp .env.prod.local.example .env.prod.local && chmod 600 .env.prod.local
#
# Every variable production reads that Compose does not set itself is here, with no real value:
# the repository is public. ProductionConfigurationTest fails when the application starts reading a
# variable this file does not name.
#
# Compose reads this file (env_file), not Symfony: write a secret between single quotes, so that
# a `$`, a `#` or a space in it is taken literally. Not here, because Compose substitutes them
# before reading this file, and deploy-prod.sh exports them: PUBLIC_URL, HTTP_PORT, PEYRA_VERSION.
# Set by compose.prod.yaml: APP_ENV, SERVER_NAME, DEFAULT_URI, MERCURE_URL, MERCURE_PUBLIC_URL,
# GOTENBERG_URL, LOCK_DSN.

###> symfony/framework-bundle ###
# Signs the sessions, the CSRF tokens and the sign-out links. `openssl rand -hex 32`. Changing it
# signs everybody out.
APP_SECRET=
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# The MariaDB server Formatool uses, with a base and a user of Peyra's own: base `pgi_mngmt`, user
# `user_pgi`, every right on that base and none elsewhere (the entrypoint only migrates it).
# serverVersion is the server's (`SELECT VERSION()`). In the password, encode @ : / # ? % (%40…).
DATABASE_URL='mysql://user_pgi:MOT_DE_PASSE@ADRESSE_DU_SERVEUR_MARIADB:3306/pgi_mngmt?serverVersion=11.8.6-MariaDB&charset=utf8mb4'
###< doctrine/doctrine-bundle ###

###> peyra/proxy ###
# The establishment's nginx, on another machine, is the only client of the container's port. Its
# address as Peyra sees it (the sign-in journal shows it while this is wrong), or REMOTE_ADDR when
# the firewall closes the port to everybody else. Comma-separated, CIDR ranges allowed.
TRUSTED_PROXIES=
###< peyra/proxy ###

###> mercure ###
# The hub bundled in the container (live follow-up of the class). Two different keys of 256 bits at
# least: `openssl rand -hex 32` each.
MERCURE_PUBLISHER_JWT_KEY=
MERCURE_SUBSCRIBER_JWT_KEY=
# The key the application publishes with: the same value as MERCURE_PUBLISHER_JWT_KEY.
MERCURE_JWT_SECRET=
###< mercure ###

###> ldap ###
# The establishment's directory, Formatool's (a Samba AD): the same values as its .env.prod.local.
# Peyra only reads it, through a service account.
LDAP_HOST=
# LDAPS: 636 and `ssl`, the CA certificate in certs/ldap-ca.pem next to compose.yaml (mounted at
# the path below). Plain LDAP: 389, `none`, and LDAP_TLS_CA_CERT_PATH empty.
LDAP_PORT=636
LDAP_ENCRYPTION=ssl
LDAP_TLS_CA_CERT_PATH=/etc/peyra/certs/ldap-ca.pem
# Where people and groups are searched, e.g. DC=…,DC=… .
LDAP_BASE_DN=
LDAP_SEARCH_DN=
LDAP_SEARCH_PASSWORD=
# Samba AD's schema. `bin/console app:ldap:check <login>` shows how a person is read with them.
LDAP_USERNAME_ATTRIBUTE=sAMAccountName
LDAP_GROUP_OBJECT_CLASS=group
PEYRA_LDAP_STABLE_ID=objectGUID
###< ldap ###

###> peyra/access ###
# Who enters (CLAUDE.md, « Authentication and access »). Groups of the directory, comma-separated.
PEYRA_STUDENT_GROUPS=cg-1,cg-2
PEYRA_TEACHER_GROUPS=cg-1,cg-2
# The first administrators: logins, comma-separated. Others are designated inside Peyra.
PEYRA_ADMIN_LOGINS=
# Formatool's address, https://… without a path: the avatar menu's way back, and the forgotten
# password (Formatool's /login/magic-link). Empty: neither link is drawn.
FORMATOOL_URL=
# Only when the forgotten-password procedure is not Formatool's: its whole address.
PEYRA_PASSWORD_HELP_URL=
###< peyra/access ###
